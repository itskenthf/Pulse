# Supabase (Postgres storage only — Supabase Auth is not used, see docs/DECISIONS.md)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# GitHub OAuth App (first provider — Phase 0 login gate)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Single-user gate: only this GitHub username may sign in — anyone else
# who authorizes the OAuth app is rejected before an account is created.
OWNER_GITHUB_USERNAME=

# Shared secret the GitHub Actions scheduler sends to /api/cron. Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Also set as a repo secret in GitHub Actions — see docs/DECISIONS.md.
CRON_SECRET=

# Steam Web API key (steamcommunity.com/dev/apikey) — Steam widget
STEAM_API_KEY=

# Spotify app (developer.spotify.com/dashboard) — Spotify widget's own
# "Connect Spotify" flow, not a NextAuth provider (see docs/DECISIONS.md).
# Redirect URI to register: <AUTH_URL>/api/auth/callback/spotify
AUTH_SPOTIFY_ID=
AUTH_SPOTIFY_SECRET=

# Added in later phases as widgets are built:
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET (Calendar + Gmail)
# YOUTUBE_API_KEY
